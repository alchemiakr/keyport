{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keyport",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "keyport",
      "migrations_dir": "migrations","database_id": "b747091e-0d4b-4782-ada1-fd90c5303288"
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "preview_urls": false,
  "previews": {}
}
